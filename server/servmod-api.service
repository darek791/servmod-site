[Unit]
Description=ServMod API (accounts, licences, support)
After=network.target

[Service]
User=servmod
Group=servmod
WorkingDirectory=/opt/servmod-app
EnvironmentFile=/etc/servmod/api.env
ExecStartPre=+/bin/bash /var/lib/servmod-repo/server/repair_venv.sh
ExecStartPre=+/bin/chmod -R u=rwX,g=rX,o= /opt/servmod-app/servmod_api
ExecStartPre=+/bin/chown -R root:servmod /opt/servmod-app/servmod_api
ExecStart=/opt/servmod-app/venv/bin/python -m uvicorn servmod_api.app:app --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips 127.0.0.1
TimeoutStartSec=400
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/servmod
ReadOnlyPaths=/etc/servmod /var/www/servmod/servmod

[Install]
WantedBy=multi-user.target
